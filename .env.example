# ─── Admin panel ────────────────────────────────────────────────────────────
# The shared password for /admin. Required — with it unset the panel refuses
# every login rather than falling back to something guessable.
ADMIN_PASSWORD=

# Optional. Signs the admin session cookie. Defaults to ADMIN_PASSWORD, which
# means changing the password also signs everyone out. Set it to any long
# random string if you would rather the two were independent.
ADMIN_SESSION_SECRET=

# ─── Where saved content lives ──────────────────────────────────────────────
# Set BLOB_READ_WRITE_TOKEN to use Vercel Blob (Vercel sets this for you once a
# Blob store is attached to the project). Leave it unset to keep content in a
# JSON file on disk instead, which is what local development uses.
# BLOB_READ_WRITE_TOKEN=
# BLOB_PREFIX=mcil-content

# File backend only: where site.json and uploads/ are written.
# Defaults to ./content. Point this at a mounted volume on hosts that have one.
# CONTENT_DIR=

# Largest filing the admin panel will accept, in MB. Default 50.
# MAX_DOCUMENT_MB=50

# Optional. Hold the last read of the content store for this many milliseconds.
# Unset (the default) means every request reads fresh, so a save shows up
# immediately. Raising it trades exactly that away.
# CONTENT_CACHE_MS=0
