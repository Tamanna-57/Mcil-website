# ─── Admin panel ────────────────────────────────────────────────────────────
# The shared password for /admin. Required — with it unset the panel refuses
# every login rather than falling back to something guessable, and the login
# page says so. To try the panel locally, put a password here in .env.local.
ADMIN_PASSWORD=

# Optional. Signs the admin session cookie. Defaults to ADMIN_PASSWORD, which
# means changing the password also signs everyone out. Set it to any long
# random string if you would rather the two were independent.
ADMIN_SESSION_SECRET=

# ─── Where saved content lives ──────────────────────────────────────────────
# Set GCS_BUCKET to keep content and uploads in Cloud Storage — the production
# arrangement on Cloud Run, where credentials come from the service account the
# revision runs as. Leave it unset to use a JSON file on disk instead, which is
# what local development does.
# GCS_BUCKET=
# GCS_PREFIX=

# File backend only: where site.json and uploads/ are written.
# Defaults to ./content. Point this at a mounted volume on hosts that have one.
# CONTENT_DIR=

# Largest filing the admin panel will accept, in MB. Default 32, which is the
# largest request body Cloud Run will accept.
# MAX_DOCUMENT_MB=32

# Optional. Hold the last read of the content store for this many milliseconds.
# Unset (the default) means every request reads fresh, so a save shows up
# immediately. Raising it trades exactly that away.
# CONTENT_CACHE_MS=0
